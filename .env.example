NODE_ENV=development
PORT=4000
API_BASE_PATH=/api/v1

# MongoDB must be a replica set — transactions require it.
# Local dev: docker run -p 27017:27017 mongo:7 --replSet rs0 (then rs.initiate())
MONGO_URI=mongodb://localhost:27017/freshcart?replicaSet=rs0

REDIS_URL=redis://localhost:6379

JWT_SECRET=change-me-in-production-min-32-chars-long
JWT_ACCESS_TTL=60m
REFRESH_TTL_DAYS=60

ARGON2_MEMORY_KB=19456
ARGON2_TIME_COST=2

S3_ENDPOINT=http://localhost:9000
S3_BUCKET=freshcart
S3_KEY=minioadmin
S3_SECRET=minioadmin
S3_PUBLIC_BASE=http://localhost:9000/freshcart

OTP_PROVIDER=console
OTP_API_KEY=
OTP_SENDER_ID=
WHATSAPP_BSP_KEY=

EXPO_ACCESS_TOKEN=

ENCRYPTION_KEY=change-me-32-byte-base64-encoded-key===

DEFAULT_TIMEZONE=Asia/Dubai

PLATFORM_ORIGIN=http://localhost:5174
ADMIN_ORIGIN_PATTERN=http://localhost:5173
